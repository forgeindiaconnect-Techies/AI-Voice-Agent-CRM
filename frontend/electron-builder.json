{
  "appId": "com.forge.crm",
  "productName": "Forge CRM Desktop",
  "copyright": "Copyright © 2026 Forge India Connect",
  "directories": {
    "output": "release/${version}",
    "buildResources": "public"
  },
  "files": [
    "package.json",
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "executableName": "ForgeCRM",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/login.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Forge CRM",
    "differentialPackage": false
  },
  "publish": null
}
